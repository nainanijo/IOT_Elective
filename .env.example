# =============================================================================
# IoT Smart Notice Board - Environment Configuration Template
# Copy this file to .env on your Raspberry Pi or backend server.
# NEVER commit your actual .env file or real secrets to version control.
# =============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=5000
FLASK_ENV=production
FLASK_DEBUG=false

# Backend Administrator Authentication
# Replace with a strong, secure passphrase in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Security & Session Token Configuration
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_secret_key
TOKEN_EXPIRY_SECONDS=86400

# Allowed CORS Origins (comma-separated list)
# Include local development origins and your Firebase Hosting live domains:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://iot-notice-board-naina.web.app,https://iot-notice-board-naina.firebaseapp.com

# Persistence Storage Directories (relative to backend root or absolute)
DATA_DIR=data
UPLOAD_FOLDER=uploads
